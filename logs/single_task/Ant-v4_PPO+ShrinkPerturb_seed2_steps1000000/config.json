{
  "variant": "PPO+ShrinkPerturb",
  "env": "Ant-v4",
  "seed": 2,
  "cfg": {
    "desc": "PPO + Shrink-and-Perturb (Ash & Adams 2020)",
    "use_p3o": false,
    "use_layernorm": false,
    "use_regen_reg": false,
    "use_sp": true
  },
  "hp": {
    "lr": "0.0003",
    "buffer_size": "8192",
    "batch_size": "256",
    "gamma": "0.99",
    "gae_lambda": "0.95",
    "train_steps": "1000000",
    "epochs_per_update": "10",
    "clip_range": "0.2",
    "clip_grad_norm": "0.5",
    "hidden_size": "256",
    "hidden_layers": "3",
    "activation": "Tanh",
    "reset_rate": "0.01",
    "reset_frequency": "50000",
    "alpha_start": "0.6",
    "alpha_end": "0.2",
    "alpha_lambda": "4.0",
    "alpha_td_k": "0.1",
    "alpha_min": "0.15",
    "alpha_max": "0.65",
    "alpha_eps": "1e-08",
    "alpha_dual_lr": "0.035",
    "alpha_target_kl": "0.025",
    "alpha_progress_blend": "0.55",
    "distill_loss_bound": "0.01",
    "distill_max_steps": "80",
    "td_ema_decay": "0.9",
    "td_ref_decay": "0.99",
    "metric_eps": "1e-08",
    "regen_lambda": "0.0001",
    "sp_lambda": "0.01",
    "sp_frequency": "50000"
  }
}
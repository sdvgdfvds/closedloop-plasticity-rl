{
  "env": "Walker2d-v4",
  "algo": "P3O-ClosedLoopAlpha",
  "seed": 1,
  "hp": {
    "lr": 0.0003,
    "buffer_size": 8192,
    "batch_size": 256,
    "gamma": 0.99,
    "train_steps": 500000,
    "epochs_per_update": 10,
    "clip_range": 0.2,
    "clip_grad_norm": 0.5,
    "hidden_size": 256,
    "hidden_layers": 3,
    "activation": "<class 'torch.nn.modules.activation.Tanh'>",
    "reset_rate": 0.01,
    "reset_frequency": 50000,
    "alpha_dkl": 0.4,
    "alpha_start": 0.6,
    "alpha_end": 0.2,
    "alpha_lambda": 4.0,
    "alpha_td_k": 0.1,
    "alpha_min": 0.15,
    "alpha_max": 0.65,
    "alpha_eps": 1e-08,
    "alpha_dual_lr": 0.035,
    "alpha_target_kl": 0.025,
    "alpha_progress_blend": 0.55,
    "distill_loss_bound": 0.01,
    "distill_max_steps": 80,
    "hard_top_ratio": 0.3,
    "reset_rate_min": 0.002,
    "reset_rate_max": 0.03,
    "reset_k": 0.8,
    "td_ema_decay": 0.9,
    "td_ref_decay": 0.99,
    "metric_eps": 1e-08,
    "reset_td_weight": 1.0,
    "reset_kl_weight": 0.35,
    "reset_ent_weight": 0.2,
    "priority_td_weight": 0.7,
    "priority_kl_weight": 0.3,
    "priority_gamma": 1.5,
    "distill_mix_random": 0.2,
    "importance_act_weight": 0.7,
    "importance_weight_weight": 0.3,
    "sbp_warmup_steps": 20000,
    "sbp_min_interval": 20000,
    "sbp_force_interval": 80000,
    "sbp_event_threshold": 0.35
  },
  "settings": {
    "alpha_mode": "dynamic",
    "adaptive_alpha": true,
    "dual_alpha": true,
    "adaptive_reset": true,
    "hard_distill": true,
    "event_trigger_sbp": true
  }
}
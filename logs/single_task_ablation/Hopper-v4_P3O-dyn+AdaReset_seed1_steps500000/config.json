{
  "env": "Hopper-v4",
  "algo": "P3O-dyn+AdaReset",
  "seed": 1,
  "hp": {
    "lr": 0.0003,
    "buffer_size": 8192,
    "batch_size": 256,
    "gamma": 0.99,
    "train_steps": 500000,
    "epochs_per_update": 10,
    "clip_range": 0.2,
    "clip_grad_norm": 0.5,
    "hidden_size": 256,
    "hidden_layers": 3,
    "activation": "<class 'torch.nn.modules.activation.Tanh'>",
    "reset_rate": 0.01,
    "reset_frequency": 50000,
    "alpha_dkl": 0.4,
    "alpha_start": 0.6,
    "alpha_end": 0.2,
    "alpha_lambda": 4.0,
    "distill_loss_bound": 0.01,
    "distill_max_steps": 80,
    "hard_top_ratio": 0.3,
    "reset_rate_min": 0.002,
    "reset_rate_max": 0.03,
    "reset_k": 0.8,
    "td_ema_decay": 0.9,
    "td_ref_decay": 0.99
  },
  "settings": {
    "alpha_mode": "dynamic",
    "adaptive_reset": true,
    "hard_distill": false
  }
}